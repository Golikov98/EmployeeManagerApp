<Window x:Class="EmployeeManagerApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EmployeeManagerApp.Views"
        mc:Ignorable="d"
        Title="Менеджер сотрудников" 
        Height="1080" 
        Width="1920"
        Background="#ab9472"
        WindowState="Maximized" 
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid x:Name="mainListsGrid" Width="300" Height="964.04" Margin="50,42,1570,42">
            <ComboBox x:Name="sortListComboBox" HorizontalAlignment="Center" Width="300" Height="50" VerticalAlignment="Top"/>
            <ListBox x:Name="mainListBox" d:ItemsSource="{d:SampleData ItemCount=5}" Width="300" Height="890" Margin="0,74,0,0"/>
        </Grid>

        <Image x:Name="accountImage" Height="50" VerticalAlignment="Top" Width="50" Stretch="Uniform" Source="/Images/userIcon.png" Margin="1565,50,305,0"/>
        <ComboBox x:Name="accountComboBox" HorizontalAlignment="Right" Margin="0,50,50,0" VerticalAlignment="Top" Width="250" Height="50" Background="Transparent"/>
    </Grid>
</Window>